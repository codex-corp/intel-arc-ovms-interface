Screen {
    background: $background;
    color: $text;
    layout: vertical;
}

Header {
    background: $panel;
    color: $primary;
    dock: top;
    height: 1;
    text-style: bold;
}

HeaderIcon {
    color: $primary;
}

HeaderTitle {
    color: $text;
    text-style: bold;
}

Footer {
    background: $panel;
    color: $text-muted;
    dock: bottom;
    height: 1;
}

/* Top Live Telemetry Bar */
#top-bar {
    height: 4;
    background: $surface;
    padding: 0 1;
    margin-bottom: 1;
}

.status-pill {
    height: 3;
    width: 1fr;
    background: $panel;
    border: round $border;
    padding: 0 1;
    content-align: center middle;
    text-style: bold;
    margin: 0 1;
}

.status-pill.online {
    border: round $success;
    color: $success;
}

.status-pill.offline {
    border: round $error;
    color: $error;
}

.status-pill.accent {
    border: round $accent;
    color: $accent;
}

/* Tabbed Navigation */
TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 1;
}

Tabs {
    background: $surface;
    border-bottom: solid $primary;
    padding: 0 1;
}

Tab {
    padding: 0 2;
    color: $text-muted;
}

Tab.-active {
    color: $primary;
    text-style: bold;
    background: $panel;
}

/* Chat Section */
#chat-scroll {
    height: 1fr;
    background: $background;
    border: round $border;
    padding: 1;
    margin-bottom: 1;
    scrollbar-size: 1 1;
}

.chat-user-card {
    margin: 1 0;
    padding: 1;
    background: $boost;
    border: round $primary;
    color: $text;
}

.chat-assistant-card {
    margin: 1 0;
    padding: 1;
    background: $panel;
    border: round $accent;
    color: $text;
}

.chat-reasoning-box {
    margin: 0 0 1 0;
    padding: 1;
    background: $surface;
    border: dashed $warning;
    color: $text-muted;
}

/* Gemini-style Floating Chat Compose Card */
#chat-compose-container {
    height: auto;
    background: transparent;
    border: round $primary;
    padding: 0 1 1 1;
    margin-top: 1;
}

#chat-input {
    width: 1fr;
    height: 4;
    max-height: 8;
    background: transparent;
    border: none;
    padding: 0 1;
    color: $text;
}

#chat-input:focus {
    border: none;
    background: transparent;
}

#chat-compose-toolbar {
    height: 3;
    align: left middle;
}

#chat-compose-left {
    height: 3;
    width: 1fr;
    align: left middle;
}

#chat-compose-right {
    height: 3;
    width: auto;
    align: right middle;
}

#chat-model {
    width: 22;
    height: 3;
    border: dashed $border;
    background: transparent;
    margin-right: 1;
}

#chat-model:hover {
    border: dashed $primary;
}

SelectCurrent {
    background: transparent;
    border: none;
    padding: 0 1;
}

#compose-device-chip {
    color: $accent;
    background: transparent;
    padding: 0 1;
    text-style: bold;
}

#clear-chat-btn {
    min-width: 8;
    border: dashed $border;
    background: transparent;
    color: $text-muted;
    margin-right: 1;
}

#clear-chat-btn:hover {
    border: dashed $warning;
    color: $warning;
    background: transparent;
}

#send {
    min-width: 9;
    border: dashed $primary;
    background: transparent;
    color: $primary;
    text-style: bold;
}

#send:hover {
    border: dashed $accent;
    color: $accent;
    background: transparent;
}

/* Models Section */
#models-container {
    height: 1fr;
    layout: vertical;
}

#models-table {
    height: 1fr;
    background: $surface;
    border: round $border;
    margin-bottom: 1;
}

#model-actions {
    height: auto;
    margin-bottom: 1;
}

#model-action-select {
    width: 38;
    height: 3;
    border: dashed $border;
    background: transparent;
    margin-right: 1;
}

#model-action-select:hover {
    border: dashed $primary;
}

#download-model {
    border: dashed $primary;
    color: $primary;
}

#download-model:hover {
    border: dashed $accent;
    color: $accent;
}

#switch-model {
    border: dashed $success;
    color: $success;
}

#switch-model:hover {
    border: dashed $accent;
    color: $accent;
}

#action-output {
    height: 5;
    background: $panel;
    border: round $border;
    padding: 1;
    color: $text-muted;
}

/* System Dashboard */
#system-grid {
    grid-size: 3;
    grid-gutter: 1;
    height: auto;
    margin-bottom: 1;
}

.system-card {
    background: $panel;
    border: round $border;
    padding: 1;
    height: 9;
}

.system-card.highlight {
    border: round $primary;
}

#runtime-actions {
    height: auto;
    margin-top: 1;
}

/* Buttons - Stylish Dashed & Compact */
Button {
    height: 3;
    min-width: 8;
    border: dashed $border;
    background: transparent;
    color: $text;
    text-style: bold;
    padding: 0 1;
    margin-right: 1;
}

Button:hover {
    background: transparent;
    border: dashed $accent;
    color: $accent;
}

Button.-primary {
    border: dashed $primary;
    background: transparent;
    color: $primary;
}

Button.-primary:hover {
    border: dashed $accent;
    color: $accent;
    background: transparent;
}

Button.-success {
    border: dashed $success;
    background: transparent;
    color: $success;
}

Button.-success:hover {
    border: dashed $accent;
    color: $accent;
    background: transparent;
}

Button.-warning {
    border: dashed $warning;
    background: transparent;
    color: $warning;
}

Button.-warning:hover {
    border: dashed $accent;
    color: $accent;
    background: transparent;
}
