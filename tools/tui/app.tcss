Screen {
    background: $background;
    color: $text;
    layout: vertical;
}

Header {
    background: $panel;
    color: $primary;
    dock: top;
    height: 1;
    text-style: bold;
}

HeaderTitle {
    color: $text;
    text-style: bold;
}

Footer {
    background: $panel;
    color: $text-muted;
    dock: bottom;
    height: 1;
}

/* Top Live Telemetry Bar */
#top-bar {
    height: 3;
    background: $surface;
    padding: 0 1;
    margin-bottom: 0;
    align: left middle;
}

.status-pill {
    height: 1;
    width: auto;
    background: $panel;
    padding: 0 1;
    content-align: center middle;
    text-style: bold;
    margin: 0 1 0 0;
}

.status-pill.online {
    color: $success;
}

.status-pill.offline {
    color: $error;
}

.status-pill.accent {
    color: $accent;
}

/* Tabbed Navigation */
TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0 1;
}

Tabs {
    background: $surface;
    border-bottom: solid $secondary 50%;
    padding: 0 1;
}

Tab {
    padding: 0 2;
    color: $text-muted;
}

Tab.-active {
    color: $primary;
    text-style: bold;
    background: $panel;
}

/* Chat Canvas & Stream Area */
#chat-scroll {
    height: 1fr;
    background: $background;
    border: none;
    padding: 1 1 0 1;
    margin-bottom: 0;
    scrollbar-size-vertical: 1;
}

/* User Message Card */
.user-msg-card {
    margin: 1 0;
    padding: 0 1;
    background: $boost 35%;
    border-left: outer $secondary;
    color: $text;
    height: auto;
}

/* Assistant Message Card */
.chat-assistant-card {
    margin: 1 0;
    padding: 0 1;
    background: transparent;
    border: none;
    color: $text;
    height: auto;
}

/* Tool Invocation Header (▶ 🔧 Find files ✓) */
.tool-call-header {
    margin: 1 0 0 0;
    padding: 0;
    color: $text-muted;
    height: auto;
}

/* Terminal Tool Box (Matching Toad's TerminalTool with Green Panel Border) */
.terminal-tool-card {
    height: auto;
    border: panel $success;
    border-title-color: $success;
    border-title-style: bold;
    background: $success 7%;
    color: $foreground;
    padding: 0 1;
    margin: 0 0 1 0;
}

.terminal-tool-card.-error {
    border: panel $error;
    border-title-color: $error;
    background: $error 7%;
}

/* Plan / Task Tracking Card (Matching Toad's Plan Widget) */
.plan-card {
    height: auto;
    border-top: ascii $secondary;
    border-bottom: ascii $secondary;
    border-left: blank $secondary;
    border-right: wide $secondary;
    border-title-color: $secondary;
    border-title-style: bold;
    background: black 15%;
    padding: 0 1;
    margin: 1 0;
}

/* Thought / Reasoning Stream */
.thought-card {
    margin: 0 0 1 0;
    padding: 0 1;
    background: $surface 60%;
    border: dashed $warning 60%;
    color: $text-muted;
    height: auto;
}

/* Toad-style Prompt Container */
#chat-compose-container {
    height: auto;
    background: black 15%;
    border: round $border;
    padding: 0 1;
    margin: 0 0 0 0;
}

#chat-compose-container:focus-within {
    border: round $secondary;
}

#chat-input-row {
    height: auto;
    min-height: 3;
    max-height: 8;
    align: left top;
}

#chat-prompt-glyph {
    color: $secondary;
    width: 2;
    text-style: bold;
    padding-top: 0;
}

#chat-input {
    width: 1fr;
    height: auto;
    min-height: 3;
    max-height: 7;
    background: transparent;
    border: none;
    padding: 0;
    color: $text;
}

#chat-input:focus {
    border: none;
    background: transparent;
}

#prompt-shortcuts-row {
    height: 1;
    align: right middle;
    margin-bottom: 0;
}

#prompt-shortcuts-text {
    color: $text-muted;
    text-align: right;
    width: 1fr;
}

/* Info Bar Below Prompt (Matching Toad's #info-container) */
#info-container {
    height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    align: left middle;
}

#info-agent-pill {
    width: auto;
    margin-right: 1;
}

#info-path-text {
    width: 1fr;
    color: $text-muted;
}

#info-mode-pill {
    width: auto;
    text-align: right;
}

/* Model Selector Toolbar */
#chat-model-toolbar {
    height: 3;
    margin-top: 0;
    align: left middle;
}

#chat-model {
    width: 30;
    height: 3;
    border: dashed $border;
    background: transparent;
    margin-right: 1;
}

#chat-model:hover {
    border: dashed $secondary;
}

#clear-chat-btn {
    min-width: 8;
    border: dashed $border;
    background: transparent;
    color: $text-muted;
    margin-right: 1;
}

#clear-chat-btn:hover {
    border: dashed $warning;
}

#send {
    min-width: 10;
    text-style: bold;
}

/* Model Manager Tab */
#models-container {
    height: 1fr;
    padding: 1;
}

#models-table {
    height: 1fr;
    border: round $border;
    background: $surface;
    margin-bottom: 1;
}

#model-actions {
    height: 3;
    margin-bottom: 1;
    align: left middle;
}

#model-action-select {
    width: 32;
    height: 3;
    margin-right: 1;
}

#model-actions Button {
    margin-right: 1;
}

#action-output {
    height: 6;
    border: dashed $border;
    background: $panel;
    padding: 1;
    color: $text;
}

/* System Health Tab */
#system-grid {
    grid-size: 3;
    grid-gutter: 1;
    height: 1fr;
    margin-bottom: 1;
}

.system-card {
    border: round $border;
    background: $panel;
    padding: 1;
    color: $text;
}

.system-card.highlight {
    border: round $primary;
}

#runtime-actions {
    height: 3;
    align: left middle;
}

#runtime-actions Button {
    margin-right: 1;
}
